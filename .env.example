# Copy this file to .env and fill in values
# Then create the secret: kubectl create secret generic comic-secrets --from-env-file=.env -n comic-prod

# Database
POSTGRES_DB=comic
POSTGRES_USER=comic
POSTGRES_PASSWORD=<change-me>
DATABASE_URL=postgresql+asyncpg://comic:<change-me>@postgres.comic-prod.svc.cluster.local:5432/comic
DB_USER=comic
DB_PASSWORD=<change-me>
DB_NAME=comic

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=<change-me-min-8-chars>
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=<change-me-min-8-chars>

# Backend
SECRET_KEY=<change-me-random-string>

# Cloudflare Tunnel
TUNNEL_TOKEN=<your-cloudflare-tunnel-token>
